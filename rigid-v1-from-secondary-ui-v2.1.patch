+ rb_marker_restore = marker
+ rb_frame_next = rb_frame_start
+ rb_job = true
+ rb_baking = false
+ window_busy = "rigidjob"
+ rb_notice = "Simulating range... Press Esc to cancel. No keyframes are being changed."
