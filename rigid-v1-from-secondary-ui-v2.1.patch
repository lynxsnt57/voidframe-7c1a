+ {
+  rb_job = false
+  window_busy = ""
+  if (rb_baking)
+  {
+   rb_baking = false
+   action_rb_bake_commit()
+  }
+  else
+  {
+   rb_session = 2
+   rb_cache_valid = true
+   timeline_marker = rb_marker_restore
+   rb_evaluate(timeline_marker)
+   tl_update_matrix()
+   rb_history_mark()
