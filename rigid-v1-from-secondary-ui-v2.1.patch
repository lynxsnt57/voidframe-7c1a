+ }
+ rb_frame_next++
+ var last = rb_baking ? rb_frame_end+1 : rb_frame_end;
+ rb_notice = (rb_baking ? "Preparing Bake: " : "Simulating: ") + string(frame) + " / " + string(last) + " (Esc to cancel)"
