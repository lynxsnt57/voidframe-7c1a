/// text_get(key, val1, val2...)
/// @arg key
/// @arg val1
/// @arg val2...

function text_get()
{
	if (argument[0] == "graphpointvalue") return "Value"

	var key, map;
	key = argument[0]
	if (key = "secondaryv2_1") return "Stiffness X"
	if (key = "secondaryv2_2") return "Stiffness Y"
	if (key = "secondaryv2_3") return "Stiffness Z"
	if (key = "secondaryv2_4") return "Damping X"
	if (key = "secondaryv2_5") return "Damping Y"
	if (key = "secondaryv2_6") return "Damping Z"
	if (key = "secondaryv2_7") return "Travel X"
	if (key = "secondaryv2_8") return "Travel Y"
	if (key = "secondaryv2_9") return "Travel Z"
	if (key = "secondarypresetlist") return "Preset"
	if (key = "secondarymodelist") return "Simulation mode"
	if (key = "secondaryteststart") return "Start live test"
	if (key = "secondaryteststop") return "Stop live test"
	if (key = "secondaryfiles") return "Preset files"
	if (key = "secondaryaxes") return "Advanced axis settings"
	if (key = "secondarygeometry") return "Import anchor and tip"
	if (key = "secondarysave") return "Save preset..."
	if (key = "secondaryload") return "Load preset..."
	if (key == "rigidautotools") return "Automatic setup (optional)"
	if (key == "rigidautofall") return "Auto Setup + Forward Fall"
	if (key == "rigidautosetup") return "Auto Setup - Whole Rig"
	if (key == "rigidautoground") return "Background ground collision"
	if (key == "rigidbody") return "Rigid Body / Ragdoll (experimental)"
	if (key == "rigidmotion") return "Motion type"
	if (key == "rigidshape") return "Collider shape"
	if (key == "rigidjoint") return "Parent connection"
	if (key == "rigidtarget") return "Joint / weld target"
	if (key == "rigidsetup") return "Selection setup"
	if (key == "rigidcollider") return "Collider settings"
	if (key == "rigidmaterial") return "Material and damping"
	if (key == "rigidlimits") return "Joint limits"
	if (key == "rigidvelocity") return "Initial velocity"
	if (key == "rigidcache") return "Simulation range and Bake"
	if (key == "rigidstoppreview") return "Stop Preview"
	if (key == "rigidpreview") return "Preview"
	if (key == "rigidreset") return "Reset"
	if (key == "rigidsimulate") return "Simulate range"
	if (key == "rigidbake") return "Bake to keyframes"
	if (key == "rigidshow") return "Show colliders"
	if (key == "rigiddynamic") return "Make Dynamic"
	if (key == "rigidstatic") return "Make Static"
	if (key == "rigidragdoll") return "Setup Ragdoll"
	if (key == "rigidweld") return "Weld Selection"
	if (key == "rigidstart") return "Start frame"
	if (key == "rigidend") return "End frame"
	if (key == "rigidvalue0") return "Enabled"
	if (key == "rigidvalue1") return "Motion"
	if (key == "rigidvalue2") return "Shape"
	if (key == "rigidvalue3") return "Mass"
	if (key == "rigidvalue4") return "Friction"
	if (key == "rigidvalue5") return "Restitution"
	if (key == "rigidvalue6") return "Linear damping"
	if (key == "rigidvalue7") return "Angular damping"
	if (key == "rigidvalue8") return "Size X"
	if (key == "rigidvalue9") return "Size Y"
	if (key == "rigidvalue10") return "Size Z"
	if (key == "rigidvalue11") return "Offset X"
	if (key == "rigidvalue12") return "Offset Y"
	if (key == "rigidvalue13") return "Offset Z"
	if (key == "rigidvalue14") return "Connection"
	if (key == "rigidvalue15") return "Limit X (deg)"
	if (key == "rigidvalue16") return "Limit Y (deg)"
	if (key == "rigidvalue17") return "Limit Z (deg)"
	if (key == "rigidvalue18") return "Velocity X"
	if (key == "rigidvalue19") return "Velocity Y"
	if (key == "rigidvalue20") return "Velocity Z"
	if (key == "rigidvalue21") return "Spin X (deg/s)"
	if (key == "rigidvalue22") return "Spin Y (deg/s)"
	if (key == "rigidvalue23") return "Spin Z (deg/s)"
	if (key == "rigidvalue24") return "Target"
	if (key == "rigidvalue25") return "Collision layer"
	if (key == "rigidvalue26") return "Collision mask"
	if (key = "secondaryenabled") return "Secondary motion (experimental)"
	if (key = "secondaryblend") return "Influence (%)"
	if (key = "secondaryfrequency") return "Stiffness (Hz)"
	if (key = "secondarydamping") return "Damping"
	if (key = "secondaryinertia") return "Movement inertia"
	if (key = "secondarygravity") return "Gravity (Z down)"
	if (key = "secondarylimit") return "Swing limit (deg)"
	if (key = "secondaryanchor_x") return "Anchor X"
	if (key = "secondaryanchor_y") return "Anchor Y"
	if (key = "secondaryanchor_z") return "Anchor Z"
	if (key = "secondarytip_x") return "Tip direction X"
	if (key = "secondarytip_y") return "Tip direction Y"
	if (key = "secondarytip_z") return "Tip direction Z"
	if (key = "secondarywind_x") return "Wind X"
	if (key = "secondarywind_y") return "Wind Y"
	if (key = "secondarywind_z") return "Wind Z"
	if (key = "secondaryanchor") return "Anchor and tip (local space)"
	if (key = "secondarywind") return "Wind acceleration (world space)"
	if (key = "secondaryreset") return "Reset selected simulation"
	if (key = "secondarytip") return "Swing rotates a rigid part; Soft adds spring translation. No mesh deformation or collisions. Preview is non-destructive; stop it before playback/export."
	if (key = "secondaryanchortip") return "Anchor is a local point fixed to the animated part. Tip is an offset from the anchor: choose the direction along the hair or tail. No viewport gizmo in v1."
	if (key = "typemeshimport") return "3D import (experimental)"
	if (key = "benchmeshopen") return "Open glTF / GLB model..."
	if (key = "benchmeshselect") return "Open glTF / GLB with mesh selection..."
	if (key = "benchmeshrigid") return "Open glTF / GLB with rigid bones (experimental)..."
	if (key = "benchmeshsmooth") return "Open glTF / GLB with smooth bones (experimental)..."
	// Fallback labels for the experimental controls, including older language packs.
    if (key = "renderglowcrispcore") return "Glow: brighter core"
    if (key = "renderglowlessblur") return "Glow: reduce blur"
    if (key = "timelineeditoraddobjectlight") return "Add attached point light"
    if (key = "timelineeditorobjectlightadded") return "Attached point light added"
    if (key = "viewrotationspace0") return "Gimbal axes | Left: next, Right: previous"
    if (key = "viewrotationspace1") return "Local axes | Left: next, Right: previous"
    if (key = "viewrotationspace2") return "Global axes | Left: next, Right: previous"
    if (key = "viewrotationletter0") return "G"
    if (key = "viewrotationletter1") return "L"
    if (key = "viewrotationletter2") return "W"
    if (key = "settingskeyrotationspace") return "Cycle rotation space"
	map = language_map
	
	if (!ds_map_exists(map, key))
	{
		if (!text_exists(key))
			return "<No text found for \"" + key + "\">"
	
		map = language_english_map
	}
	
	var text = map[?key];
	for (var a = 1; a < argument_count; a++)
		text = string_replace(text, "%" + string(a), argument[a])
	
	return text
}
